# Copy to .env and fill in. Never commit real secrets.

# --- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/avio"

# Used only by `npm test`. The database name must end in "_test"; every table in
# it is wiped by the test suite.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/avio_test"

# --- App ----------------------------------------------------------------------
# Public origin of this deployment. When set, state-changing API requests must
# come from exactly this origin. Leave empty to compare against the request host.
APP_URL="http://localhost:3000"

# invite = sign-up needs a valid invite code (create one with `npm run invite:create`)
# open   = anyone can sign up
# closed = sign-up is disabled
REGISTRATION_MODE="invite"

# Credits granted to every new account.
INITIAL_CREDITS="5000"

# AI requests each user may start per minute (a comparison counts as two).
AI_RATE_LIMIT_PER_MINUTE="20"

# --- AI providers -------------------------------------------------------------
# A provider only appears in the app when its key is set and the provider accepts
# it. Keys stay on the server; they are never sent to the browser.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Optional: route a provider through a gateway or proxy.
# OPENAI_BASE_URL=""
# ANTHROPIC_BASE_URL=""
# GEMINI_BASE_URL=""
